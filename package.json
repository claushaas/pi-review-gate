{
  "name": "pi-review-gate",
  "version": "0.1.0",
  "description": "Mandatory review gate extension for Pi Coding Agent.",
  "type": "module",
  "main": "./src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.75.5"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@earendil-works/pi-coding-agent": "link:/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
